{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["role", "runId", "variant", "summary", "outputs", "issues", "next"],
  "additionalProperties": false,
  "properties": {
    "role": {
      "type": "string",
      "pattern": "^atlas-[a-z-]+$"
    },
    "runId": {
      "type": "string"
    },
    "variant": {
      "type": "string",
      "const": "small"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "description"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "issues": {
      "type": "string"
    },
    "next": {
      "type": "object",
      "required": ["role", "firstAction"],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string"
        },
        "firstAction": {
          "type": "string"
        }
      }
    },
    "schemaVersion": {
      "type": "string",
      "default": "1.0.0"
    }
  }
}
